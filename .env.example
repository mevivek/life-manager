# life-manager — environment variables
#
# THIS FILE IS COMMITTED. It documents variable NAMES only. Never put a value here.
# Real values live in two gitignored files, and only ever locally:
#
#   apps/api/.env    every variable in the "API" block below
#   apps/web/.env    every variable in the "WEB" block below
#
# Why two files and not one at the root: CLAUDE.md invariant 1 — only apps/api may hold a
# database credential. Keeping the API's .env inside apps/api makes that boundary physical
# rather than aspirational. It also means drizzle-kit and Vite each pick their own file up
# automatically from their package root, with no path juggling.
#
# Production values go to `fly secrets set` (API) and the Cloudflare Pages project
# settings (web). See docs/security-model.md §6.


# ─────────────────────────────────────────────────────────────────────────────
# API  →  apps/api/.env
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=
PORT=
HOST=
LOG_LEVEL=

# Postgres (Neon). TWO strings for the SAME database, and they are not interchangeable:
#
#   DATABASE_URL           the POOLED endpoint (host contains `-pooler`). Used by the app's
#                          pg Pool. ADR-0005.
#   DATABASE_URL_UNPOOLED  the DIRECT endpoint. Used by drizzle-kit and by pg-boss.
#                          pg-boss needs LISTEN/NOTIFY and session-level advisory locks,
#                          neither of which survives PgBouncer transaction pooling — a lock
#                          taken on one backend and released on another leaks forever.
#
# Both are in the Neon dashboard: project → branch → Connection details.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. Signs and encrypts sessions and tokens; rotating it logs everyone out.
# Use a DIFFERENT value per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public origin of the API, ORIGIN ONLY — no path. Better Auth's `baseURL` and the OpenAPI
# `servers` entry. A path here would override `basePath` and move the auth routes.
#   local:      http://localhost:8080
#   production: https://api.mevivek.dev
API_BASE_URL=

# Public origin of the web app. CORS allowlist + Better Auth `trustedOrigins`.
#   local:      http://localhost:5173
#   production: https://app.mevivek.dev
WEB_ORIGIN=

# Cookie Domain attribute, enabling one session cookie across app.* and api.*.
# LEAVE EMPTY IN LOCAL DEV (localhost is already same-site). ADR-0019.
#   production: .mevivek.dev
COOKIE_DOMAIN=

# Optional, tests only. If set, the API test suite uses this database instead of starting
# a Testcontainers Postgres — which is how tests run on a machine without Docker.
# It is TRUNCATED between tests. Never point it at anything you care about. ADR-0018.
TEST_DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# WEB  →  apps/web/.env
# ─────────────────────────────────────────────────────────────────────────────

# Baked into the bundle at build time, so it is public by construction.
# NEVER put anything secret behind a VITE_ prefix. Same value as API_BASE_URL.
VITE_API_URL=


# ─────────────────────────────────────────────────────────────────────────────
# FILES — Cloudflare R2 (ADR-0008). OPTIONAL, all four or none.
# ─────────────────────────────────────────────────────────────────────────────
#
# With none of them set, the file endpoints answer 503 and the rest of Documents works
# normally. That is deliberate: `pnpm test` and a fresh clone need no storage credential.
#
# The bucket has NO public access, ever. There is deliberately no R2_PUBLIC_BASE_URL —
# every read goes through a short-lived presigned GET.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# How long a presigned upload/download URL is valid, in seconds. Default 600 (10 minutes).
R2_PRESIGN_TTL_SECONDS=


# ─────────────────────────────────────────────────────────────────────────────
# WEB PUSH — reminder delivery. OPTIONAL, all three or none.
# ─────────────────────────────────────────────────────────────────────────────
#
# Generate a pair with:   node scripts/generate-vapid-keys.mjs
#
# Use THAT script, not another VAPID generator: `webpush-webcrypto` encodes its private key in
# its own format, so a pair from `web-push --generate-vapid-keys` will not load.
#
# VAPID_PUBLIC_KEY is public by design — it is served to browsers so they can subscribe.
# VAPID_PRIVATE_KEY is a secret and belongs in Secret Manager in production.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────────────────────
# BACKGROUND JOBS
# ─────────────────────────────────────────────────────────────────────────────
#
# `true` registers the recurring schedules (reminder scan at 08:00 UTC, sweep at 09:00).
# Default false, and that default is a decision, not laziness: a schedule means something
# must always be running, which forces an always-on host and keeps Neon's compute awake
# (ADR-0012, ADR-0014, debt D8). Handlers are registered either way, so you can still fire
# one by hand in development.
#
# Switching this on in a deployed environment TRIGGERS debt D8: measure Neon compute hours
# that month before assuming the free tier still covers it.

ENABLE_SCHEDULED_JOBS=


# ─────────────────────────────────────────────────────────────────────────────
# NOT NEEDED YET
# ─────────────────────────────────────────────────────────────────────────────
#
# Transactional email:         RESEND_API_KEY  EMAIL_FROM
#   Until email exists there is no password reset. See docs/product/review.md D11.
