{
  "name": "life-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/check-schema-barrel.mjs && biome check .",
    "format": "biome check --write .",
    "check:schema-barrel": "node scripts/check-schema-barrel.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^22.15.0",
    "openapi-types": "^12.1.3",
    "turbo": "^2.10.7",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
