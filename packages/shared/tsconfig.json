{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nodenext, not bundler: this package is consumed by apps/api, which runs as real
    // Node ESM. Relative imports therefore carry an explicit .js extension.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "types": []
  },
  "include": ["src"]
}
